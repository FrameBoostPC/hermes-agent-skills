{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Planner Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "status", "title", "summary", "assumptions", "questions", "limitations", "data"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill": {"const": "project-planner"},
    "status": {"enum": ["ready", "partial", "needs_input"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "assumptions": {"$ref": "#/$defs/strings"},
    "questions": {"$ref": "#/$defs/strings"},
    "limitations": {"$ref": "#/$defs/strings"},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/plan"}]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ready"}}}, "then": {"properties": {"data": {"type": "object", "properties": {"tasks": {"minItems": 1}}}, "questions": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "needs_input"}}}, "then": {"properties": {"data": {"type": "null"}, "questions": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "partial"}}}, "then": {"properties": {"data": {"type": "object"}, "limitations": {"minItems": 1}}}}
  ],
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "date": {"type": ["string", "null"], "format": "date"},
    "milestone": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "done_when", "target_date"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "done_when": {"type": "string", "minLength": 1},
        "target_date": {"$ref": "#/$defs/date"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "milestone_id", "depends_on", "estimated_minutes", "status", "week", "deliverable"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "milestone_id": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "estimated_minutes": {"type": "integer", "minimum": 1},
        "status": {"const": "planned"},
        "week": {"type": "integer", "minimum": 1},
        "deliverable": {"type": "string", "minLength": 1}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["goal", "success_criteria", "time_budget_hours_per_week", "time_budget_minutes_total", "start_date", "deadline", "timezone", "milestones", "tasks", "first_action", "deferred"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "time_budget_hours_per_week": {"type": ["number", "null"], "minimum": 0, "maximum": 168},
        "time_budget_minutes_total": {"type": ["integer", "null"], "minimum": 0},
        "start_date": {"$ref": "#/$defs/date"},
        "deadline": {"$ref": "#/$defs/date"},
        "timezone": {"type": ["string", "null"], "minLength": 1},
        "milestones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/milestone"}},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
        "first_action": {"type": "string", "minLength": 1},
        "deferred": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
