{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research brief output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "status", "title", "summary", "assumptions", "questions", "limitations", "data"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill": {"const": "research-brief"},
    "status": {"enum": ["ready", "partial", "needs_input"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "assumptions": {"$ref": "#/$defs/strings"},
    "questions": {"$ref": "#/$defs/strings"},
    "limitations": {"$ref": "#/$defs/strings"},
    "data": {
      "oneOf": [
        {"$ref": "#/$defs/brief"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"properties": {"data": {"type": "object", "properties": {"sources": {"minItems": 1}, "findings": {"minItems": 1}}}, "questions": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "partial"}}},
      "then": {"properties": {"data": {"type": "object"}, "limitations": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "needs_input"}}},
      "then": {"properties": {"data": {"type": "null"}, "questions": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "scope", "answer", "findings", "sources", "conflicts", "next_actions"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "answer": {"type": "string", "minLength": 1},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "conflicts": {"$ref": "#/$defs/strings"},
        "next_actions": {"$ref": "#/$defs/strings", "minItems": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "source_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^finding-[1-9][0-9]*$"},
        "type": {"enum": ["fact", "inference", "hypothesis"]},
        "text": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^source-[1-9][0-9]*$"}}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["fact", "inference"]}}},
          "then": {"properties": {"source_ids": {"minItems": 1}}}
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "url", "read_at", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^source-[1-9][0-9]*$"},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["provided_text", "read_url"]},
        "url": {"type": ["string", "null"], "format": "uri", "pattern": "^https?://"},
        "read_at": {"type": ["string", "null"], "format": "date"},
        "notes": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "read_url"}}},
          "then": {"properties": {"url": {"type": "string"}, "read_at": {"type": "string"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "provided_text"}}},
          "then": {"properties": {"read_at": {"type": "null"}}}
        }
      ]
    }
  }
}
